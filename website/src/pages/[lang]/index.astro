---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Screens from '../../components/Screens.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import { t } from '../../i18n';
import { type Lang, langPath, url, RELEASE } from '../../site';
import { langPaths } from './_paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const other = lang === 'ar' ? 'en' : 'ar';
---
<Base lang={lang} page="" title={d.home.title}>
  <section class="hero">
    <div class="copy">
      <span class="badge">{d.home.badge}</span>
      <h1>{d.home.headline}</h1>
      <p class="lead">{d.home.sub}</p>
      <div class="ctas">
        {RELEASE.available
          ? <a class="btn btn-primary" href={langPath(lang, 'download')}><Icon name="download" size={20} />{d.common.downloadCta}</a>
          : null}
        <a class="btn btn-ghost" href={langPath(lang, 'features')}>{d.common.exploreCta}</a>
      </div>
      {!RELEASE.available && <div style="margin-top:16px"><DownloadPanel lang={lang} /></div>}
      <ul class="facts">{d.home.facts.map((f) => <li><Icon name="check" size={18} />{f}</li>)}</ul>
    </div>
    <figure class="phone">
      <img src={url(`/screenshots/${lang}-home.webp`)} alt={d.shots.home} width="540" height="1200" fetchpriority="high" />
      <figcaption class="muted">{d.common.previewLabel}</figcaption>
    </figure>
  </section>

  <section class="section">
    <h2>{d.features.title}</h2>
    <div class="grid feat">
      {d.features.items.slice(0, 6).map((f) => (
        <article class="card">
          <span class="ico"><Icon name={f.icon} /></span>
          <h3>{f.title}</h3>
          <p class="muted">{f.body}</p>
        </article>
      ))}
    </div>
    <p><a href={langPath(lang, 'features')}>{d.common.learnMore} →</a></p>
  </section>

  <section class="section">
    <h2>{d.how.title}</h2>
    <ol class="steps">
      {d.how.steps.map((s, i) => <li class="card"><span class="num">{i + 1}</span><div><h3>{s.title}</h3><p class="muted">{s.body}</p></div></li>)}
    </ol>
  </section>

  <section class="section">
    <h2>{d.home.previewsTitle}</h2>
    <p class="muted">{d.home.previewsSub}</p>
    <Screens lang={lang} items={[
      { file: `${lang}-home`, alt: d.shots.home },
      { file: `${lang}-meals`, alt: d.shots.meals },
      { file: `${lang}-recipe`, alt: d.shots.recipe },
      { file: `${lang}-guide`, alt: d.shots.guide },
      { file: `${other}-home`, alt: d.shots.home + (lang === 'ar' ? ' (English)' : ' (العربية)') },
    ]} />
  </section>

  {RELEASE.available && <section class="section"><DownloadPanel lang={lang} compact /></section>}

  <section class="section">
    <div class="notice warn"><Icon name="info" /><p style="margin:0">{d.home.disclaimerShort} <a href={langPath(lang, 'disclaimer')}>{d.nav.disclaimer}</a></p></div>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.15fr .85fr; gap: 40px; align-items: center; padding: 24px 0 8px; }
  .lead { font-size: 1.15rem; color: var(--ink-2); max-width: 36em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .facts { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; color: var(--ink-2); }
  .facts li { display: flex; align-items: center; gap: 6px; }
  .facts :global(svg) { color: var(--primary); }
  .phone { margin: 0; justify-self: center; max-width: 300px; }
  .phone img { border-radius: 34px; border: 8px solid var(--ink); box-shadow: var(--shadow); }
  .phone figcaption { font-size: .8rem; text-align: center; margin-top: 8px; }
  .section { margin-top: 56px; }
  .feat { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .ico { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--mint); color: var(--primary); margin-bottom: 10px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .steps li { display: flex; gap: 14px; align-items: flex-start; }
  .num { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--btn); color: #fff; display: grid; place-items: center; font-weight: 700; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } .phone { max-width: 240px; } }
</style>
