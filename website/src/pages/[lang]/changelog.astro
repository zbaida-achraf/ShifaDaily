---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';
import { type Lang, ISSUES_URL } from '../../site';
import { langPaths } from './_paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} page="changelog" title={d.changelog.title}>
  <div class="prose">
    <h1>{d.changelog.title}</h1>
    {d.changelog.entries.map((e) => (
      <section class="card" style="margin-bottom:16px">
        <h2><span class="mono">{e.version}</span></h2>
        <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))}
  </div>
</Base>
