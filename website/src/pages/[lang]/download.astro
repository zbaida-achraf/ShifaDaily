---
import Base from '../../layouts/Base.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import { t } from '../../i18n';
import { type Lang, RELEASE, ANDROID_NAME } from '../../site';
import { langPaths } from './_paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const minAndroid = RELEASE.minSdk ? ANDROID_NAME[RELEASE.minSdk] : '8.0';
---
<Base lang={lang} page="download" title={d.download.title}>
  <h1>{d.download.title}</h1>
  <p class="prose muted">{d.download.intro}</p>
  <DownloadPanel lang={lang} />
  <section class="card" style="margin-top:24px">
    <h2>{d.download.requirementsTitle}</h2>
    <ul>{d.download.requirements.map((r) => <li>{r.replace('{v}', minAndroid)}</li>)}</ul>
    <p class="muted" style="margin:0">{d.download.noIos}</p>
  </section>
</Base>
