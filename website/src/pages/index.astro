---
// Language chooser at the root. With JavaScript, Arabic browsers go to /ar/, others to /en/;
// without JavaScript both links are shown.
import { langPath, url } from '../site';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ShifaDaily — شفاء يومي</title>
  <meta name="description" content="ShifaDaily: medication reminders and diabetes-conscious meal ideas, in Arabic and English." />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href={langPath('en')} />
  <link rel="alternate" hreflang="ar" href={langPath('ar')} />
  <script is:inline define:vars={{ en: langPath('en'), ar: langPath('ar') }}>
    try { var l = (navigator.languages && navigator.languages[0]) || navigator.language || ''; location.replace(/^ar\b/i.test(l) ? ar : en); } catch (e) {}
  </script>
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, "Segoe UI", Roboto, "Noto Sans Arabic", Tahoma, sans-serif; background: #F8FAFC; color: #172B2A; }
    @media (prefers-color-scheme: dark) { body { background: #0F1716; color: #E2ECEA; } }
    main { text-align: center; padding: 24px; }
    a { display: inline-block; margin: 8px; padding: 14px 28px; border-radius: 14px; background: #087F70; color: #fff; text-decoration: none; font-weight: 700; font-size: 1.1rem; }
  </style>
</head>
<body>
  <main>
    <h1>ShifaDaily · <span lang="ar">شفاء يومي</span></h1>
    <a href={langPath('ar')} lang="ar" hreflang="ar">العربية</a>
    <a href={langPath('en')} lang="en" hreflang="en">English</a>
  </main>
</body>
</html>
